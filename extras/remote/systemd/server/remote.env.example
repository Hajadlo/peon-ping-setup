# Copy to ~/.config/peon-ping-setup/remote.env on the agent server. All optional.
# Read by peon-remote (sourced by bash) and by the systemd units (EnvironmentFile),
# so keep plain KEY=value lines without quotes or $-expansion.
#PEON_RUNTIME=<absolute path of the upstream peon.sh>
#PEON_RELAY_PORTS=19996,19998
#PEON_FANOUT_BACKENDS=127.0.0.1:19998,100.64.0.12:19998
#PEON_GATE_INPUT_PASSTHROUGH=/my-forms-mcp/server.ts
#PEON_T3_GATE=0
